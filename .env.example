# Copy to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit real keys.

# --- LLM (required for /api/search synthesis, ingestion, E2E eval) ---

# OpenRouter (recommended for local dev)
LLM_API_KEY=sk-or-v1-your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Yandex Cloud (alternative — uncomment and comment OpenRouter block above)
# LLM_API_KEY=AQVNyour-yandex-api-key
# LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# LLM_FOLDER_ID=b1gxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt://b1gxxxxxxxxxxxxxxxx/gpt-oss-120b/latest

# Alias accepted instead of LLM_MODEL:
# LLM_MODEL_ID=openai/gpt-4o-mini

# --- Optional: database & Neo4j ---

# HSME_DATABASE_FILE=db_state.pkl

# USE_NEO4J=true
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=hsme_password
# NEO4J_DATABASE=neo4j

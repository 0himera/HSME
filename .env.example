# Copy to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit real keys.

# --- LLM (required for /api/search synthesis, ingestion, E2E eval) ---

# OpenRouter (recommended for local dev)
LLM_API_KEY=sk-or-v1-your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Yandex Cloud (alternative — uncomment and comment OpenRouter block above)
# YANDEX_API_KEY=AQVNyour-yandex-api-key
# YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxx
# YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# LLM_API_KEY=AQVNyour-yandex-api-key
# LLM_FOLDER_ID=b1gxxxxxxxxxxxxxxxx
# YANDEX_MODEL=yandexgpt-5.1/latest

# Alias accepted instead of LLM_MODEL:
# LLM_MODEL_ID=openai/gpt-4o-mini

# --- Optional: database & Neo4j ---

# HSME_DATABASE_FILE=.local/db_state.pkl
# HSME_EMBEDDINGS_CACHE_FILE=.local/embeddings_cache.pkl

# USE_NEO4J=true
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=hsme_password
# NEO4J_DATABASE=neo4j

# --- Async graph sync (Stage 3: outbox + Redis Streams + Neo4j worker) ---

# USE_ASYNC_GRAPH_SYNC=false
# ASYNC_GRAPH_SYNC_REQUIRED=false
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_STREAM_KEY=hsme:graph_sync
# REDIS_CONSUMER_GROUP=hsme-neo4j-workers
# OUTBOX_DB_PATH=.local/graph_sync_outbox.db
# OUTBOX_PUBLISH_BATCH_SIZE=50
# OUTBOX_MAX_ATTEMPTS=5
# REDIS_CONSUMER_BLOCK_MS=2000
# REDIS_PENDING_MIN_IDLE_MS=60000
# OUTBOX_STALE_PUBLISHED_S=300
# BROKER_DRY_RUN=false
